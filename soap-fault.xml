<?xml version="1.0" encoding="UTF-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">

  <soap:Body>
    <soap:Fault>
      <faultcode>soap:Server</faultcode>
      <faultstring>Payment declined by card issuer</faultstring>
      <detail>
        <pay:ChargeFault xmlns:pay="http://payflex.example.com/payment/wsdl">
          <pay:faultCode>card_declined</pay:faultCode>
          <pay:faultMessage>The card issuer declined this transaction.</pay:faultMessage>
        </pay:ChargeFault>
      </detail>
    </soap:Fault>
  </soap:Body>

</soap:Envelope>